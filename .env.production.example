# ==============================================================================
# Comlina Production Environment Variables Template
# Copy this file to your production Secret Manager or .env.production file.
# NEVER commit the filled version of this file to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
VERSION=1.0.0
PORT=8000
HOST=0.0.0.0

# Number of Gunicorn / Uvicorn worker processes (Formula: (2 x vCPU) + 1, min 2)
WEB_CONCURRENCY=4

# Automatically run pending SQL migrations on container startup (true/false)
RUN_MIGRATIONS=true

# ------------------------------------------------------------------------------
# 2. Managed Database Service (Supabase, AWS RDS, GCP Cloud SQL, Neon)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>?sslmode=require
# Examples:
#   Supabase Transaction Pooler (Port 6543 - Recommended for high concurrency):
#     DATABASE_URL=postgresql+asyncpg://postgres.vrfwgoigtmixkkunvrnw:[DB-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?sslmode=require
#   Supabase Direct Connection (Port 5432):
#     DATABASE_URL=postgresql+asyncpg://postgres:[DB-PASSWORD]@db.vrfwgoigtmixkkunvrnw.supabase.co:5432/postgres?sslmode=require
#   AWS RDS PostgreSQL:
#     DATABASE_URL=postgresql+asyncpg://comlina_admin:[DB-PASSWORD]@comlina-db.c7x8y9.us-east-1.rds.amazonaws.com:5432/comlina?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:[DB-PASSWORD]@[MANAGED-HOST]:5432/comlina?sslmode=require

# Database Connection Pool Configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_SSL=true

# ------------------------------------------------------------------------------
# 3. Redis Queue & Cache (Upstash, AWS ElastiCache, or Self-Hosted)
# ------------------------------------------------------------------------------
# Upstash Redis over TLS:
#   rediss://default:[TOKEN]@[HOST].upstash.io:6379
# Render Managed Redis (internal network):
#   redis://comlina-redis:6379
REDIS_URL=rediss://default:[REDIS-TOKEN]@[HOST].upstash.io:6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Token Encryption Key (Fernet / AES-256-GCM)
# ------------------------------------------------------------------------------
# MUST be a 32-byte URL-safe base64-encoded key.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=[YOUR-FERNET-32-BYTE-BASE64-KEY]

# ------------------------------------------------------------------------------
# 5. Supabase Authentication & JWT Verification
# ------------------------------------------------------------------------------
SUPABASE_URL=https://vrfwgoigtmixkkunvrnw.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZyZndnb2lndG1peGtrdW52cm53Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDAwMjk2NTgsImV4cCI6MjA1NTYwNTY1OH0.38f-bYQ2z0i4d9Fv-j7q9kH8s3n8s7m3n8s7m3n8s7m
# Must match your Supabase Project Settings -> API -> JWT Secret:
SUPABASE_JWT_SECRET=[YOUR-PRODUCTION-SUPABASE-JWT-SECRET]
BACKEND_JWT_SECRET=[YOUR-PRODUCTION-SUPABASE-JWT-SECRET]

# ------------------------------------------------------------------------------
# 6. Meta / Instagram Graph API & Webhook Configuration
# ------------------------------------------------------------------------------
META_APP_ID=964103992653470
META_APP_SECRET=[YOUR-PRODUCTION-META-APP-SECRET]
META_WEBHOOK_VERIFY_TOKEN=[YOUR-STRONG-RANDOM-VERIFY-TOKEN]
META_GRAPH_API_VERSION=v21.0
META_REDIRECT_URI=https://app.comlina.ai/connect/instagram

# ------------------------------------------------------------------------------
# 7. CORS Origins & Security
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (No trailing slashes, NEVER use '*' in production)
CORS_ORIGINS=https://app.comlina.ai,https://comlina.ai,https://www.comlina.ai

# ------------------------------------------------------------------------------
# 8. Frontend / Vercel Environment Variables (Exposed to browser via NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.comlina.ai/api
NEXT_PUBLIC_SUPABASE_URL=https://vrfwgoigtmixkkunvrnw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZyZndnb2lndG1peGtrdW52cm53Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDAwMjk2NTgsImV4cCI6MjA1NTYwNTY1OH0.38f-bYQ2z0i4d9Fv-j7q9kH8s3n8s7m3n8s7m3n8s7m
