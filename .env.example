# Comlina Environment Configuration Template
# Copy this file to .env and configure your secrets.
# NEVER commit real credentials to version control.

# --- Environment & App ---
ENVIRONMENT=production
PROJECT_NAME=Comlina
VERSION=1.0.0
ENABLE_DEV_ROUTES=false
LOG_LEVEL=INFO

# --- Meta Instagram Graph API ---
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_secure_random_verify_token_here
META_GRAPH_API_VERSION=v21.0
META_REDIRECT_URI=https://app.comlina.ai/connect/instagram

# --- Supabase & Authentication ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
BACKEND_JWT_SECRET=your_backend_jwt_secret_here
SUPABASE_JWKS_URL=

# --- Security & Encryption ---
# Cryptographically secure 32-byte urlsafe base64 key(s). MultiFernet supports comma-separated keys:
TOKEN_ENCRYPTION_KEY=your_primary_32_byte_base64_encryption_key
TOKEN_ENCRYPTION_KEYS=your_primary_key,optional_previous_key_for_rotation

# --- Network & Reverse Proxy ---
TRUSTED_PROXY_COUNT=1
ALLOWED_ORIGINS=https://app.comlina.ai,https://comlina.ai

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/comlina
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_SSL=true

# --- Redis Queue & Rate Limiting ---
REDIS_URL=rediss://default:your_redis_password@your_redis_host:6379/0

# --- Razorpay Payments & Subscriptions ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=https://api.comlina.ai/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
